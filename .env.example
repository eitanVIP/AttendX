# Copy this file to .env.local and fill in values from the Firebase Console
# (Project settings -> General -> Your apps -> SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional - only needed for Settings' "Google Calendar" section (see
# src/lib/googleCalendar.js). From Google Cloud Console, same project:
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# (Web application), with this site's URL under Authorized JavaScript
# origins. Leaving it blank just hides that section behind a "not set up"
# notice - nothing else in the app depends on it.
VITE_GOOGLE_CLIENT_ID=

# Optional - `npm run dev` uses the local Firestore emulator by default
# (start it with `npm run emulators`); production builds always use the real
# Firestore. Set this to true to point `npm run dev` at the real database.
VITE_USE_REAL_FIRESTORE=false
